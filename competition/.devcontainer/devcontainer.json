{
    "name": "SIGNATE Environment",
    // どのDockerfileを使ってコンテナをビルドするか指定
    "build": {
      "dockerfile": "../Dockerfile"
    },
    // ホストPCのポートとコンテナのポートを繋ぐ設定
    "forwardPorts": [8888],
    // コンテナ内で有効にしたいCursor(VS Code)の拡張機能
    "customizations": {
      "vscode": {
        "extensions": [
          "ms-python.python",
          "ms-toolsai.jupyter"
        ]
      }
    }
  }